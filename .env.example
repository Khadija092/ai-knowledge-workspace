# Copy this file to .env.local and fill in the values.
# Next.js reads env files from the project root, not from src.

# Supabase — Project Settings → API Keys
# Use the project URL only, without /rest/v1/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key stays on the server. Do not prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Dify — server only. Do not prefix these with NEXT_PUBLIC_.
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
